# Server
PORT=3000
NODE_ENV=production

# Database (postgres | mysql)
DB_TYPE=postgres
DB_HOST=your-db-host
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=templatecraft

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=24h

# Production frontend URL (comma-separated for multiple origins)
CORS_ORIGIN=http://103.131.24.113:8080

# Elasticsearch (Docker: docker compose up -d elasticsearch)
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=campaign_events

# Redis (Docker: docker compose up -d redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=    # uncomment if Redis auth enabled

# Analytics archive retention (days)
# ARCHIVE_RETENTION_DAYS=30

# Optional uploads
# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 / CloudFront Configuration
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_CLOUDFRONT_URL=

# Local/dev only — fake MSISDN when operator HE headers are absent
# HE_DUMMY_MSISDN=211911961169
